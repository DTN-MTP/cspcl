+int csp_rdp_wait_acked(csp_conn_t * conn, uint32_t timeout_ms) {
+
+	if ((conn->opts & CSP_O_RDP) == 0)
+		return CSP_ERR_NONE;
+
+	uint32_t start = csp_get_ms();
+
+	while (1) {
+
+		if (conn->rdp.state != RDP_OPEN) {
+			csp_log_error("RDP %p: Cannot wait for ACKs, connection not open (%d)", conn, conn->rdp.state);
+			return CSP_ERR_RESET;
+		}
+
+		/* All transmitted sequence numbers acknowledged by the peer */
+		if (conn->rdp.snd_una == conn->rdp.snd_nxt)
+			return CSP_ERR_NONE;
+
+		uint32_t elapsed = csp_get_ms() - start;
+
+		if (elapsed >= timeout_ms) {
+			csp_log_warn("RDP %p: Timeout waiting for ACK, una %u, nxt %u",
+					conn, conn->rdp.snd_una, conn->rdp.snd_nxt);
+			return CSP_ERR_TIMEDOUT;
+		}
+
+		/* Sleep until the router task signals progress (ACK processed or
+		 * window updated). The wait is capped so connection state changes
+		 * that do not post tx_wait are still noticed promptly. */
+		uint32_t slice = timeout_ms - elapsed;
+
+		if (slice > 100)
+			slice = 100;
+		csp_bin_sem_wait(&conn->rdp.tx_wait, slice);
+
+	}
+
+}
