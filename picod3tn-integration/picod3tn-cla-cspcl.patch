diff --git a/nix/checks/tests/picod3tn-cspcl.nix b/nix/checks/tests/picod3tn-cspcl.nix
new file mode 100644
index 0000000..35ad512
--- /dev/null
+++ b/nix/checks/tests/picod3tn-cspcl.nix
@@ -0,0 +1,136 @@
+# SPDX-License-Identifier: Apache-2.0
+
+# Two picoD3TN instances exchange bundles via the cspcl CLA over the virtual CAN bus vcan0.
+#
+# Both instances run in the same VM: vcan0 only exists within one kernel.
+{
+  name = "picoD3TN cspcl";
+
+  nodes = {
+    machine =
+      { pkgs, ... }:
+      {
+        environment.systemPackages = with pkgs; [
+          picod3tn-cspcl
+          python-ud3tn-utils
+        ];
+
+        boot.kernelModules = [ "vcan" ];
+
+        systemd.services = {
+          vcan0 = {
+            description = "Virtual CAN bus vcan0";
+            wantedBy = [ "multi-user.target" ];
+            path = [ pkgs.iproute2 ];
+            serviceConfig = {
+              Type = "oneshot";
+              RemainAfterExit = true;
+            };
+            script = ''
+              ip link add dev vcan0 type vcan
+              ip link set up vcan0
+            '';
+          };
+          "picod3tn@alice" = {
+            requires = [ "vcan0.service" ];
+            after = [ "vcan0.service" ];
+          };
+          "picod3tn@bob" = {
+            requires = [ "vcan0.service" ];
+            after = [ "vcan0.service" ];
+          };
+        };
+
+        services.picod3tn = {
+          alice = {
+            enable = true;
+            logLevel = "debug";
+            aap2Listen.port = 1110;
+            mtcpclListen.port = 1111;
+            cspcl = {
+              localAddr = 1;
+              interface = "can:vcan0";
+            };
+          };
+          bob = {
+            enable = true;
+            logLevel = "debug";
+            aap2Listen.port = 2220;
+            mtcpclListen.port = 2222;
+            cspcl = {
+              localAddr = 2;
+              interface = "can:vcan0";
+            };
+          };
+        };
+      };
+  };
+
+  testScript = ''
+    start_all()
+
+    with subtest("Wait for picoD3TN services"):
+      machine.wait_for_unit("vcan0.service")
+      machine.wait_for_unit("picod3tn@alice.service")
+      machine.wait_for_open_port(1110) # AAP2 Listen
+      machine.wait_for_unit("picod3tn@bob.service")
+      machine.wait_for_open_port(2220) # AAP2 Listen
+      machine.wait_until_succeeds("journalctl -u picod3tn@alice.service | grep 'cspcl link open as CSP 1:10'")
+      machine.wait_until_succeeds("journalctl -u picod3tn@bob.service | grep 'cspcl link open as CSP 2:10'")
+
+    with subtest("cspcl cannot be the default CLA"):
+      machine.fail("picod3tn --default-peer-cla-address cspcl:2:10")
+
+    with subtest("Configure the cspcl links"):
+      machine.succeed(
+        "aapctl configure "
+        "--connect tcp:127.0.0.1:1110 "
+        "dtn://alice.dtn/admin "
+        "dtn://bob.dtn/ "
+        "cspcl:2:10 "
+        "LINK_STATUS_UP"
+      )
+      machine.succeed(
+        "aapctl configure "
+        "--connect tcp:127.0.0.1:2220 "
+        "dtn://bob.dtn/admin "
+        "dtn://alice.dtn/ "
+        "cspcl:1:10 "
+        "LINK_STATUS_UP"
+      )
+
+    with subtest("Send a message from alice to bob via cspcl"):
+      machine.succeed(
+        "aapctl send "
+        "--connect tcp:127.0.0.1:1110 "
+        "dtn://alice.dtn/sender "
+        "dtn://bob.dtn/receiver "
+        "hello-bob"
+      )
+      machine.succeed(
+        "aap2-receive "
+        "--agentid receiver "
+        "--tcp 127.0.0.1 2220 "
+        "--count 1 "
+        "--verify-source dtn://alice.dtn/sender "
+        "--verify-pl hello-bob"
+      )
+
+    with subtest("Send a message from bob to alice via cspcl"):
+      machine.succeed(
+        "aapctl send "
+        "--connect tcp:127.0.0.1:2220 "
+        "dtn://bob.dtn/sender "
+        "dtn://alice.dtn/receiver "
+        "hello-alice"
+      )
+      machine.succeed(
+        "aap2-receive "
+        "--agentid receiver "
+        "--tcp 127.0.0.1 1110 "
+        "--count 1 "
+        "--verify-source dtn://bob.dtn/sender "
+        "--verify-pl hello-alice"
+      )
+  '';
+}
diff --git a/nix/packages/libcsp.nix b/nix/packages/libcsp.nix
new file mode 100644
index 0000000..5cdf9e8
--- /dev/null
+++ b/nix/packages/libcsp.nix
@@ -0,0 +1,85 @@
+# SPDX-License-Identifier: Apache-2.0
+
+# libcsp v1.6, as linked by the cspcl CLA (`cspcl-sys`).
+#
+# The output has the layout `cspcl-sys` expects from `CSP_REPO_DIR`: the headers in `include/`,
+# and `build/` with the generated `include/csp/csp_autoconfig.h` and the static `libcsp.a`.
+
+{
+  lib,
+  stdenv,
+  fetchFromGitHub,
+  pkg-config,
+  python311,
+  libsocketcan,
+  zeromq,
+}:
+
+stdenv.mkDerivation (finalAttrs: {
+  pname = "libcsp";
+  version = "1.6";
+
+  src = fetchFromGitHub {
+    owner = "libcsp";
+    repo = "libcsp";
+    rev = "v${finalAttrs.version}";
+    hash = "sha256-3yJ+I5FROh7s/3hxJ2GGV/2gEJ+7M7wlN+O8Kmpg9no=";
+  };
+
+  # The bundled waf (2.0.18) imports `imp`, which Python 3.12 removed.
+  nativeBuildInputs = [
+    pkg-config
+    python311
+  ];
+
+  buildInputs = [
+    libsocketcan
+    zeromq
+  ];
+
+  # Rust links position-independent executables, so the static library needs `-fPIC`. libcsp v1.6
+  # only applies its default flags when CFLAGS is empty, so they are all set here.
+  env.CFLAGS = toString [
+    "-std=gnu99"
+    "-g"
+    "-Os"
+    "-fPIC"
+    "-Wall"
+    "-Wextra"
+    "-Wshadow"
+    "-Wcast-align"
+    "-Wwrite-strings"
+    "-Wno-unused-parameter"
+  ];
+
+  configurePhase = ''
+    runHook preConfigure
+    python3 waf configure \
+      --enable-can-socketcan \
+      --enable-if-zmqhub \
+      --enable-rdp \
+      --with-os=posix
+    runHook postConfigure
+  '';
+
+  buildPhase = ''
+    runHook preBuild
+    python3 waf build
+    runHook postBuild
+  '';
+
+  installPhase = ''
+    runHook preInstall
+    mkdir --parents $out/build
+    cp --recursive include $out/
+    cp --recursive build/include build/libcsp.a $out/build/
+    runHook postInstall
+  '';
+
+  meta = {
+    description = "Cubesat Space Protocol, built for the cspcl CLA";
+    homepage = "https://github.com/libcsp/libcsp";
+    license = lib.licenses.lgpl21Plus;
+    platforms = lib.platforms.linux;
+  };
+})
